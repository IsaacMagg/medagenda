# Copie para .env.local e preencha com os dados do seu projeto Supabase.
# Ambas as variáveis são públicas por natureza (vão para o navegador).
# A chave service_role NÃO entra aqui — ela ignora o RLS e só pode viver
# em um servidor, nunca no front-end.
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-anon-key

# Só servidor — nunca com prefixo NEXT_PUBLIC_.
# Usada apenas pela rota /api/administracao/clinicas, para criar a conta de
# acesso da clínica. Ignora o RLS; trate como senha de banco.
SUPABASE_SERVICE_ROLE_KEY=sua-service-role-key
